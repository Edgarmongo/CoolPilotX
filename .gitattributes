# 统一换行符：仓库内一律 LF，避免 Windows 下 CRLF 造成的无意义 diff
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.jar binary
*.pdf binary
*.xlsx binary
*.docx binary

# 迁移脚本与锁文件按文本处理，避免合并冲突时被当成二进制
*.sql text
package-lock.json text
