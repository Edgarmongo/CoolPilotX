# 仅本机开发使用。生产部署的配置由部署环境注入，不放在仓库里。
# 复制为 .env 后填写，.env 已被 .gitignore 排除。

# ---------- PostgreSQL ----------
CPX_DB_NAME=coolpilotx
CPX_DB_USER=cpx_app
CPX_DB_PASSWORD=
CPX_DB_PORT=5432

# 后端连接串（容器内主机名为 postgres）
CPX_DB_URL=jdbc:postgresql://127.0.0.1:5432/coolpilotx

# ---------- 后端 ----------
CPX_SERVER_PORT=8080

# ---------- AI 服务 ----------
CPX_AI_BASE_URL=http://127.0.0.1:8000
CPX_AI_PORT=8000
# 模型接入。首期未定，见 docs/decisions/OPEN-QUESTIONS.md A-1
CPX_LLM_BASE_URL=
CPX_LLM_API_KEY=
CPX_LLM_MODEL=
